# SPDX-License-Identifier: BSD-2-Clause
#
# The Java2Shell guard, a Java agent for JDK 17 and later. build.sh
# builds java2shell-base64-guard.jar, then runs shirudo bpm build.

[package]
name = "java2shell-base64-guard"
description = "A Java agent that refuses the Base64 input the HotSpot x86-64 AVX-512 decode stub mishandles, Java2Shell CVE-2026-114938, on JDK 17 and later"
license = "GPL-2.0 OR BSD-2-Clause"
authors = ["shirudo-upatches contributors"]

[[upatches]]
type = "java"
source = "java2shell-base64-guard.jar"

[upatches.tree]
id = "java2shell-base64-guard"
fixes = ["CVE-2026-114938"]

[upatches.tree.selector]
architecture = ["x86_64"]
